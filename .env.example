# Copie para .env (ou rode .\configurar.ps1, que gera tokens aleatórios)
WUZAPI_ADMIN_TOKEN=troque-por-um-token-aleatorio
WUZAPI_GLOBAL_ENCRYPTION_KEY=troque-por-32-caracteres-aleatorios
WUZAPI_USER_TOKEN=troque-por-outro-token-aleatorio

